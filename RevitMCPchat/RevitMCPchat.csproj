<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>RevitMCPchat</RootNamespace>
    <AssemblyName>RevitMCPchat</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <RevitYear Condition="'$(RevitYear)' == ''">2022</RevitYear>
    <BaseOutputPath>bin\$(RevitYear)\</BaseOutputPath>
    <RevitApiPackageVersion Condition="'$(RevitYear)' == '2022'">2022.1.80</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitYear)' == '2023'">2023.1.90</RevitApiPackageVersion>
    <RevitApiPackageVersion Condition="'$(RevitYear)' == '2024'">2024.3.60</RevitApiPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiPackageVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="ValidateRevitYear" BeforeTargets="PrepareForBuild" Condition="'$(RevitApiPackageVersion)' == ''">
    <Error Text="Unsupported RevitYear '$(RevitYear)'. Supported values are 2022, 2023 and 2024." />
  </Target>
</Project>
