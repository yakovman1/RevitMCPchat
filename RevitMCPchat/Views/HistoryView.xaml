<UserControl x:Class="RevitMCPchat.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
            <CheckBox Content="Все чаты" DockPanel.Dock="Left" IsChecked="{Binding AllChats, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding LoadCommand}" Padding="9,4" />
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <ListBox Grid.Column="0" ItemsSource="{Binding Chats}" SelectedItem="{Binding SelectedChat}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ModelId}" FontSize="11" Foreground="#FF667085" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="{Binding SelectedChat.Title, FallbackValue='Выберите чат'}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedChat.ModelIdentity}" Margin="0,5,0,10" FontSize="11" Foreground="#FF667085" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedChat.ProviderId}" />
                <TextBlock Text="{Binding SelectedChat.ModelId}" Margin="0,2,0,8" />
                <TextBox Text="{Binding RenameTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                <WrapPanel>
                    <Button Content="Открыть" Command="{Binding OpenSelectedCommand}" Padding="9,4" Margin="0,0,6,0" />
                    <Button Content="Переименовать" Command="{Binding RenameSelectedCommand}" Padding="9,4" Margin="0,0,6,0" />
                    <Button Content="Удалить" Command="{Binding DeleteSelectedCommand}" Padding="9,4" />
                </WrapPanel>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="#FF667085" TextWrapping="Wrap" />
    </Grid>
</UserControl>
