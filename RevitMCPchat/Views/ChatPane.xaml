<Page x:Class="RevitMCPchat.Views.ChatPane"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:views="clr-namespace:RevitMCPchat.Views"
      Title="Revit MCP Chat"
      Background="#FFF5F6F8">
    <Grid Margin="12">
        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Чат">
                <Grid Margin="10" DataContext="{Binding Chat}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Revit MCP Chat" FontSize="18" FontWeight="SemiBold" Foreground="#FF20242A" />
                            <TextBlock Text="{Binding ModelStatus}" Margin="0,3,0,0" Foreground="#FF4B5563" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,8,0">
                            <TextBlock Text="{Binding ProviderId}" Foreground="#FF667085" VerticalAlignment="Center" />
                            <TextBlock Text=" · " Foreground="#FF667085" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ModelId}" Foreground="#FF667085" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Новый чат"
                                Command="{Binding DataContext.NewChatCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                Padding="10,5" />
                    </DockPanel>

                    <Border Grid.Row="1" Padding="8" Margin="0,0,0,8" Background="#FFE8EEF7" CornerRadius="4">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Подключить" Command="{Binding ReconnectCommand}" Margin="8,0,0,0" Padding="9,4" />
                            <TextBlock Text="{Binding McpGuidance}" TextWrapping="Wrap" Foreground="#FF344054" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="White" Padding="8">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" Margin="0,0,0,7" Background="#FFF7F8FA" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="#FF667085" />
                                            <TextBlock Text="{Binding ToolName}" Margin="0,3,0,0" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Text}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <views:ToolApprovalView Grid.Row="3" Margin="0,8,0,8" />

                    <DockPanel Grid.Row="4" LastChildFill="True">
                        <Button Content="Отправить" DockPanel.Dock="Right" Command="{Binding SendCommand}" Margin="8,0,0,0" Padding="12,6" />
                        <TextBox Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" MinHeight="54" MaxHeight="110"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="История">
                <views:HistoryView DataContext="{Binding History}" />
            </TabItem>

            <TabItem Header="Настройки">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>
    </Grid>
</Page>
